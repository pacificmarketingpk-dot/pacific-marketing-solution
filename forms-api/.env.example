# Copy this file's variable names into the Vercel project's own Environment Variables
# settings (Project -> Settings -> Environment Variables). Never commit a file with the
# real values — this file only documents what's needed.

# Hostinger mailbox (same account the PHP version used)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=info@pacificmarketingsolution.com
SMTP_PASSWORD=

# The exact origin(s) allowed to call this API, comma-separated, no trailing slash.
# Must match what the browser sends, protocol and host and (if any) port included.
ALLOWED_ORIGIN=https://pacificmarketingsolution.com

# Upstash Redis (free tier) — used only for rate limiting. Create a database at
# https://console.upstash.com, then copy its REST URL and token here. If left blank,
# rate limiting is skipped (fails open) and every other check still applies.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
